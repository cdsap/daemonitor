-- Daemonitor local history (U4 / KTD-5).
-- REDACTION INVARIANT (KTD-7): command_line and log_snippet values passed to the insert
-- statements below MUST already be redacted by the caller. Nothing writes a raw command line
-- or log line here. Peak columns are nullable; NULL encodes a sub-poll build (KTD-2).

CREATE TABLE process_samples (
    id                INTEGER PRIMARY KEY AUTOINCREMENT,
    timestamp         INTEGER NOT NULL,
    pid               INTEGER NOT NULL,
    parent_pid        INTEGER NOT NULL,
    process_type      TEXT NOT NULL,
    command_line      TEXT NOT NULL,      -- pre-redacted
    working_directory TEXT,
    project_path      TEXT,
    cpu_percent       REAL,
    rss_memory_mb     INTEGER NOT NULL,
    max_heap_mb       INTEGER,           -- configured -Xmx (argv), not live occupancy
    heap_used_mb      INTEGER,           -- live heap used (Attach/JMX); NULL = unavailable
    heap_committed_mb INTEGER,           -- live heap committed; NULL = unavailable
    heap_max_mb       INTEGER,           -- runtime heap max from MemoryMXBean; NULL = unavailable
    heap_sampled_at_ms INTEGER,          -- probe wall clock; set even when unavailable
    heap_available    INTEGER,           -- 1 = live heap fields present; 0/NULL = unavailable
    virtual_memory_mb INTEGER,
    swap_memory_mb INTEGER,
    thread_count INTEGER,
    read_bytes INTEGER,
    write_bytes INTEGER,
    read_operations INTEGER,
    write_operations INTEGER,
    minor_page_faults INTEGER,
    major_page_faults INTEGER,
    voluntary_context_switches INTEGER,
    involuntary_context_switches INTEGER,
    open_file_descriptors INTEGER,
    metaspace_used_mb INTEGER,
    metaspace_committed_mb INTEGER,
    young_gc_count INTEGER,
    young_gc_time_ms INTEGER,
    old_gc_count INTEGER,
    old_gc_time_ms INTEGER,
    java_version TEXT,
    java_vendor TEXT,
    active_processor_count INTEGER,
    status            TEXT NOT NULL
);

CREATE INDEX process_samples_pid_ts ON process_samples(pid, timestamp);
CREATE INDEX process_samples_ts ON process_samples(timestamp);

CREATE TABLE builds (
    build_id         TEXT PRIMARY KEY,
    daemon_pid       INTEGER NOT NULL,
    daemon_identity  TEXT,
    command_line     TEXT,                -- pre-redacted
    working_directory TEXT,
    project_path     TEXT,
    start_time       INTEGER NOT NULL,
    end_time         INTEGER,
    duration_seconds REAL,
    peak_memory_mb   INTEGER,
    avg_memory_mb    INTEGER,
    peak_cpu_percent REAL,
    inferred_source  TEXT NOT NULL DEFAULT 'UNKNOWN',
    final_status     TEXT NOT NULL,
    log_snippet      TEXT,                -- pre-redacted
    agent            TEXT,                -- named AI agent (env-name fingerprint), null if none
    agent_provider   TEXT                 -- LLM provider / "configurable" / "unknown"; null if none
);

CREATE INDEX builds_start ON builds(start_time);
CREATE INDEX builds_project ON builds(project_path);

-- Shared with cored. process_instances / process_events use cored column names so PreferGo
-- desktop (and Kotlin-first DBs Go opens later) share one schema. See #484.
CREATE TABLE process_instances (
    id TEXT PRIMARY KEY NOT NULL,
    host_id TEXT NOT NULL DEFAULT '',
    pid INTEGER NOT NULL,
    create_time_ms INTEGER NOT NULL,
    process_type TEXT NOT NULL,
    name TEXT,
    command_line TEXT NOT NULL DEFAULT '',
    first_observed_ms INTEGER NOT NULL,
    last_observed_ms INTEGER NOT NULL,
    disappeared_at_ms INTEGER,
    UNIQUE(host_id, pid, create_time_ms)
);
CREATE INDEX process_instances_pid ON process_instances(pid);
CREATE INDEX process_instances_last_obs ON process_instances(last_observed_ms);
CREATE INDEX process_instances_alive ON process_instances(disappeared_at_ms);

CREATE TABLE metric_definitions (
    metric_id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    unit TEXT,
    kind TEXT NOT NULL,
    temporality TEXT NOT NULL,
    source TEXT NOT NULL,
    platform TEXT,
    UNIQUE(name, source, platform)
);

CREATE TABLE resource_scopes (
    scope_id TEXT PRIMARY KEY,
    scope_type TEXT NOT NULL,
    identity TEXT NOT NULL,
    metadata_json TEXT,
    first_observed_at INTEGER NOT NULL,
    last_observed_at INTEGER NOT NULL,
    UNIQUE(scope_type, identity)
);

CREATE TABLE metric_samples (
    sample_id INTEGER PRIMARY KEY AUTOINCREMENT,
    timestamp INTEGER NOT NULL,
    instance_id TEXT NOT NULL REFERENCES process_instances(id),
    scope_id TEXT REFERENCES resource_scopes(scope_id),
    metric_id TEXT NOT NULL REFERENCES metric_definitions(metric_id),
    int_value INTEGER,
    real_value REAL,
    source TEXT NOT NULL,
    sampled_at INTEGER NOT NULL,
    CHECK ((int_value IS NOT NULL AND real_value IS NULL) OR
           (int_value IS NULL AND real_value IS NOT NULL))
);
CREATE INDEX metric_samples_instance_metric_ts ON metric_samples(instance_id, metric_id, timestamp);
CREATE INDEX metric_samples_metric_ts ON metric_samples(metric_id, timestamp);

CREATE TABLE process_events (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    schema_version INTEGER NOT NULL DEFAULT 1,
    event_type TEXT NOT NULL,
    timestamp_ms INTEGER NOT NULL,
    process_instance_id TEXT NOT NULL,
    pid INTEGER NOT NULL,
    process_type TEXT,
    source TEXT NOT NULL DEFAULT 'process_poll',
    metadata_json TEXT
);
CREATE INDEX process_events_ts ON process_events(timestamp_ms);
CREATE INDEX process_events_instance_ts ON process_events(process_instance_id, timestamp_ms);

CREATE TABLE collection_capabilities (
    capability_id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    source TEXT NOT NULL,
    supported INTEGER NOT NULL,
    available INTEGER NOT NULL,
    details_json TEXT,
    updated_at INTEGER NOT NULL
);

-- Shared with cored. These tables intentionally use the cored column names so either
-- process can create the database first and the other can read it afterwards.
CREATE TABLE observation_sessions (
    name TEXT PRIMARY KEY NOT NULL,
    host_id TEXT NOT NULL,
    association TEXT NOT NULL,
    opened_at_ms INTEGER NOT NULL,
    closed_at_ms INTEGER,
    response_json TEXT
);

CREATE TABLE observation_session_processes (
    session_name TEXT NOT NULL,
    host_id TEXT NOT NULL,
    pid INTEGER NOT NULL,
    start_time_ms INTEGER NOT NULL,
    PRIMARY KEY(session_name, host_id, pid, start_time_ms),
    FOREIGN KEY(session_name) REFERENCES observation_sessions(name)
);

CREATE TABLE observation_session_process_summaries (
    session_name TEXT NOT NULL,
    host_id TEXT NOT NULL,
    pid INTEGER NOT NULL,
    start_time_ms INTEGER NOT NULL,
    sample_count INTEGER NOT NULL,
    first_rss_mb INTEGER NOT NULL,
    peak_rss_mb INTEGER NOT NULL,
    last_rss_mb INTEGER NOT NULL,
    delta_rss_mb INTEGER NOT NULL,
    association TEXT NOT NULL,
    PRIMARY KEY(session_name, host_id, pid, start_time_ms),
    FOREIGN KEY(session_name) REFERENCES observation_sessions(name)
);
CREATE INDEX observation_sessions_opened ON observation_sessions(opened_at_ms);

insertSample:
INSERT INTO process_samples(timestamp, pid, parent_pid, process_type, command_line, working_directory, project_path, cpu_percent, rss_memory_mb, max_heap_mb, heap_used_mb, heap_committed_mb, heap_max_mb, heap_sampled_at_ms, heap_available, virtual_memory_mb, swap_memory_mb, thread_count, read_bytes, write_bytes, read_operations, write_operations, minor_page_faults, major_page_faults, voluntary_context_switches, involuntary_context_switches, open_file_descriptors, metaspace_used_mb, metaspace_committed_mb, young_gc_count, young_gc_time_ms, old_gc_count, old_gc_time_ms, java_version, java_vendor, active_processor_count, status)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

samplesInWindow:
SELECT rss_memory_mb, cpu_percent
FROM process_samples
WHERE pid = ? AND timestamp >= ? AND timestamp <= ?;

countProcessSamplesByType:
SELECT COUNT(*)
FROM process_samples
WHERE process_type = ?;

insertBuild:
INSERT OR REPLACE INTO builds(build_id, daemon_pid, daemon_identity, command_line, working_directory, project_path, start_time, end_time, duration_seconds, peak_memory_mb, avg_memory_mb, peak_cpu_percent, inferred_source, final_status, log_snippet, agent, agent_provider)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

recentBuilds:
SELECT *
FROM builds
ORDER BY start_time DESC;

buildsForDaemonPid:
SELECT *
FROM builds
WHERE daemon_pid = ?
ORDER BY start_time DESC
LIMIT ?;

searchBuilds:
SELECT *
FROM builds
WHERE lower(build_id) LIKE '%' || lower(?) || '%'
   OR lower(COALESCE(command_line, '')) LIKE '%' || lower(?) || '%'
   OR lower(COALESCE(working_directory, '')) LIKE '%' || lower(?) || '%'
   OR lower(COALESCE(project_path, '')) LIKE '%' || lower(?) || '%'
   OR lower(COALESCE(daemon_identity, '')) LIKE '%' || lower(?) || '%'
   OR lower(COALESCE(inferred_source, '')) LIKE '%' || lower(?) || '%'
   OR lower(COALESCE(final_status, '')) LIKE '%' || lower(?) || '%'
   OR lower(COALESCE(agent, '')) LIKE '%' || lower(?) || '%'
   OR lower(COALESCE(agent_provider, '')) LIKE '%' || lower(?) || '%'
ORDER BY start_time DESC
LIMIT ?;

buildsSince:
SELECT *
FROM builds
WHERE start_time >= ?
ORDER BY start_time DESC;

distinctProjects:
SELECT DISTINCT project_path
FROM builds
WHERE project_path IS NOT NULL
ORDER BY project_path;

recentProcessSamples:
SELECT *
FROM process_samples
ORDER BY timestamp DESC
LIMIT ?;

processSamplesForPid:
SELECT *
FROM process_samples
WHERE pid = ?
ORDER BY timestamp DESC
LIMIT ?;

-- Keep this projection explicit: cored may add columns to the shared table before the desktop
-- schema knows about them, and retained Visual reads must remain safe across that drift.
processSamplesInRange:
SELECT timestamp, pid, rss_memory_mb, max_heap_mb, heap_used_mb, heap_available,
       thread_count, read_bytes, write_bytes, minor_page_faults, major_page_faults,
       voluntary_context_switches, involuntary_context_switches, open_file_descriptors,
       metaspace_used_mb, young_gc_count, old_gc_count
FROM process_samples
WHERE timestamp >= ? AND timestamp <= ?
ORDER BY timestamp ASC, pid ASC;

purgeSamplesOlderThan:
DELETE FROM process_samples WHERE timestamp < ?;

purgeBuildsOlderThan:
DELETE FROM builds WHERE start_time < ?;

upsertProcessInstance:
INSERT INTO process_instances(id, host_id, pid, create_time_ms, process_type, name, command_line, first_observed_ms, last_observed_ms, disappeared_at_ms)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    last_observed_ms = excluded.last_observed_ms,
    command_line = CASE
        WHEN excluded.command_line = '' THEN process_instances.command_line
        ELSE excluded.command_line
    END,
    name = COALESCE(excluded.name, process_instances.name),
    disappeared_at_ms = COALESCE(excluded.disappeared_at_ms, process_instances.disappeared_at_ms);

processInstancesByPid:
SELECT * FROM process_instances WHERE pid = ? ORDER BY first_observed_ms;

insertMetricDefinition:
INSERT INTO metric_definitions(metric_id, name, unit, kind, temporality, source, platform)
VALUES (?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(metric_id) DO UPDATE SET
    name = excluded.name, unit = excluded.unit, kind = excluded.kind,
    temporality = excluded.temporality, source = excluded.source, platform = excluded.platform;

insertMetricSample:
INSERT INTO metric_samples(timestamp, instance_id, scope_id, metric_id, int_value, real_value, source, sampled_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertProcessEvent:
INSERT INTO process_events(schema_version, event_type, timestamp_ms, process_instance_id, pid, process_type, source, metadata_json)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

upsertResourceScope:
INSERT INTO resource_scopes(scope_id, scope_type, identity, metadata_json, first_observed_at, last_observed_at)
VALUES (?, ?, ?, ?, ?, ?)
ON CONFLICT(scope_id) DO UPDATE SET
    last_observed_at = excluded.last_observed_at,
    metadata_json = COALESCE(excluded.metadata_json, resource_scopes.metadata_json);

upsertCollectionCapability:
INSERT OR REPLACE INTO collection_capabilities(capability_id, name, source, supported, available, details_json, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

normalizedMetricSamples:
SELECT timestamp, instance_id, scope_id, metric_id, int_value, real_value, source, sampled_at
FROM metric_samples
WHERE metric_id = ? AND timestamp >= ? AND timestamp <= ?
ORDER BY timestamp DESC
LIMIT ?;

legacyMetricSamples:
SELECT timestamp, pid, rss_memory_mb, cpu_percent
FROM process_samples
WHERE timestamp >= ? AND timestamp <= ?
ORDER BY timestamp DESC
LIMIT ?;

recentObservationSessions:
SELECT *
FROM observation_sessions
ORDER BY opened_at_ms DESC
LIMIT ?;

searchObservationSessions:
SELECT *
FROM observation_sessions
WHERE lower(name) LIKE '%' || lower(?) || '%'
   OR lower(host_id) LIKE '%' || lower(?) || '%'
   OR lower(association) LIKE '%' || lower(?) || '%'
ORDER BY opened_at_ms DESC
LIMIT ?;

observationSessionProcesses:
SELECT *
FROM observation_session_process_summaries
WHERE session_name = ?
ORDER BY host_id, pid, start_time_ms;

observationBuildTotals:
SELECT COUNT(*) AS build_count,
       COALESCE(SUM(CASE WHEN final_status = 'SUCCESS' THEN 1 ELSE 0 END), 0) AS success_count,
       COALESCE(SUM(CASE WHEN final_status = 'FAILED' THEN 1 ELSE 0 END), 0) AS failure_count
FROM builds
WHERE start_time >= ? AND start_time <= ?;

purgeMetricSamplesOlderThan:
DELETE FROM metric_samples WHERE timestamp < ?;

purgeProcessEventsOlderThan:
DELETE FROM process_events WHERE timestamp_ms < ?;

purgeProcessInstancesOlderThan:
DELETE FROM process_instances
WHERE last_observed_ms < ?
  AND NOT EXISTS (SELECT 1 FROM metric_samples WHERE metric_samples.instance_id = process_instances.id)
  AND NOT EXISTS (SELECT 1 FROM process_events WHERE process_events.process_instance_id = process_instances.id);
