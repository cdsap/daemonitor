<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for Mac App Store / TestFlight. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- JVM runtime requirements for jpackage / Compose Desktop. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Local MCP HTTP server bound to 127.0.0.1. -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- User-selected ~/.gradle (or parent) access + persisted grant. -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>

    <!--
      Fill TEAMID + bundle id on the App Store packaging runner; do not commit secrets.
      <key>com.apple.application-identifier</key>
      <string>TEAMID.io.github.cdsap.daemonitor</string>
      <key>com.apple.developer.team-identifier</key>
      <string>TEAMID</string>
    -->
</dict>
</plist>
